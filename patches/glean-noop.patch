+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+use std::{env, fs};
+
+use anyhow::{bail, Context};
+use camino::Utf8PathBuf;
+
+#[cfg(test)]
+mod tests;
+
+#[derive(Copy, Clone, Eq, PartialEq, Hash)]
+enum TargetLanguage {
+    Kotlin,
+    Swift,
+    Python,
+}
+
+fn parse_language(lang: &str) -> anyhow::Result<TargetLanguage> {
+    match lang {
+        "kotlin" => Ok(TargetLanguage::Kotlin),
+        "python" => Ok(TargetLanguage::Python),
+        "swift" => Ok(TargetLanguage::Swift),
+        _ => bail!("Unknown language"),
+    }
+}
+
+fn read_package_name(config_file: Option<&camino::Utf8Path>) -> String {
+    let default_name = "mozilla.telemetry.glean.internal".to_string();
+    let Some(config_file) = config_file else {
+        return default_name;
+    };
+    let Ok(contents) = fs::read_to_string(config_file.as_std_path()) else {
+        return default_name;
+    };
+    for line in contents.lines() {
+        let line = line.trim();
+        if !line.starts_with("package_name") {
+            continue;
+        }
+        let Some((_, value)) = line.split_once('=') else {
+            continue;
+        };
+        let value = value.trim().trim_matches('"');
+        if !value.is_empty() {
+            return value.to_string();
+        }
+    }
+    default_name
+}
+
+fn write_noop_kotlin_bindings(
+    out_dir: &camino::Utf8Path,
+    package_name: &str,
+) -> anyhow::Result<()> {
+    fs::create_dir_all(out_dir.as_std_path())?;
+    let contents = format!(
+        "package {}\n\n{}",
+        package_name,
+        r#"interface OnGleanEvents {
+    fun initializeFinished()
+    fun triggerUpload()
+    fun startMetricsPingScheduler(): Boolean
+    fun cancelUploads()
+    fun shutdown()
+}
+
+interface GleanEventListener {
+    fun onEventRecorded(id: String)
+}
+
+enum class CallbackError { UnexpectedError }
+
+enum class LevelFilter { OFF, ERROR, WARN, INFO, DEBUG, TRACE }
+enum class Lifetime { PING, APPLICATION, USER }
+enum class TimeUnit { NANOSECOND, MICROSECOND, MILLISECOND, SECOND, MINUTE, HOUR, DAY }
+enum class MemoryUnit { BYTE, KILOBYTE, MEGABYTE, GIGABYTE }
+enum class HistogramType { LINEAR, EXPONENTIAL }
+enum class ErrorType { INVALID_VALUE, INVALID_LABEL, INVALID_STATE, INVALID_OVERFLOW }
+enum class UploadTaskAction { NEXT, END }
+enum class SessionMode { AUTO, LIFECYCLE, MANUAL }
+
+class DynamicLabelType
+
+data class InternalConfiguration(
+    val dataPath: String,
+    val applicationId: String,
+    val languageBindingName: String,
+    val uploadEnabled: Boolean,
+    val maxEvents: UInt?,
+    val delayPingLifetimeIo: Boolean,
+    val appBuild: String,
+    val useCoreMps: Boolean,
+    val trimDataToRegisteredPings: Boolean,
+    val logLevel: LevelFilter?,
+    val rateLimit: PingRateLimit?,
+    val enableEventTimestamps: Boolean,
+    val experimentationId: String?,
+    val enableInternalPings: Boolean,
+    val pingSchedule: Map<String, List<String>>,
+    val pingLifetimeThreshold: ULong,
+    val pingLifetimeMaxTime: ULong,
+    val maxPendingPingsCount: ULong?,
+    val maxPendingPingsDirectorySize: ULong?,
+    val sessionMode: SessionMode,
+    val sessionSampleRate: Double,
+    val sessionInactivityTimeoutMs: ULong,
+)
+
+data class PingRateLimit(
+    val secondsPerInterval: ULong,
+    val pingsPerInterval: UInt,
+)
+
+data class ClientInfoMetrics(
+    val appBuild: String,
+    val appDisplayVersion: String,
