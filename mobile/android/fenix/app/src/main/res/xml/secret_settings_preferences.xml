<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">


  <PreferenceCategory
    android:selectable="false"
    android:title="@string/secret_settings_category_toolbar_title"
    app:iconSpaceReserved="false">
    <SwitchPreferenceCompat
      android:defaultValue="false"
      android:key="@string/pref_key_use_minimal_bottom_toolbar_while_entering_text"
      android:title="@string/preferences_debug_settings_use_minimal_bottom_toolbar_while_entering_text"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:defaultValue="false"
      android:key="@string/pref_key_use_scroll_data_for_dynamic_toolbar"
      android:title="@string/preferences_debug_settings_use_scroll_data_for_dynamic_toolbar"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:defaultValue="false"
      android:key="@string/pref_key_should_show_custom_tab_extensions"
      android:title="@string/preferences_debug_settings_custom_tab_extensions"
      android:summary="@string/preferences_debug_settings_development_phase_summary"
      app:icon="@drawable/mozac_ic_warning_24" />

    <SwitchPreferenceCompat
      android:defaultValue="false"
      android:key="@string/pref_key_show_voice_search_in_display_toolbar"
      android:title="@string/preferences_debug_settings_show_voice_search_in_display_toolbar"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:defaultValue="false"
      android:key="@string/pref_key_toolbar_focus_mode"
      android:title="@string/preferences_debug_settings_show_toolbar_in_focus_mode"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:defaultValue="false"
      android:key="@string/pref_key_enable_menu_customization"
      android:title="@string/preferences_debug_settings_enable_menu_customization"
      app:iconSpaceReserved="false" />
  </PreferenceCategory>


  <PreferenceCategory
    android:selectable="false"
    android:title="@string/secret_settings_category_homepage_title"
    app:iconSpaceReserved="false">
    <SwitchPreferenceCompat
      android:defaultValue="false"
      android:key="@string/pref_key_enable_homepage_as_new_tab"
      android:title="@string/preferences_debug_settings_homepage_as_new_tab"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:defaultValue="false"
      android:key="@string/pref_key_enable_universal_edge_to_edge_wallpapers"
      android:title="@string/preferences_debug_settings_universal_edge_to_edge_wallpapers"
      app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
      android:key="@string/pref_key_enable_add_shortcuts_improvement"
      android:title="@string/preferences_debug_settings_add_shortcuts_improvement"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_show_more_shortcuts"
      android:title="@string/preferences_debug_settings_show_more_shortcuts"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_enable_homepage_customization"
      android:title="@string/preferences_debug_settings_homepage_customization"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_hide_collections"
      android:title="@string/preferences_debug_settings_hide_collections_ui"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_migrate_collections_to_tab_groups"
      android:title="@string/preferences_debug_settings_migrate_collections_to_tab_groups"
      app:iconSpaceReserved="false" />
  </PreferenceCategory>

  <PreferenceCategory
    android:selectable="false"
    android:title="@string/secret_settings_category_tabs_title"
    app:iconSpaceReserved="false">
    <SwitchPreferenceCompat
      android:key="@string/pref_key_tab_manager_opening_animation"
      android:title="@string/preferences_tab_manager_opening_animation"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_tab_groups_drag_and_drop"
      android:title="@string/preferences_tab_groups_drag_and_drop"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_tab_groups_live_reorder"
      android:title="@string/preferences_tab_groups_live_reorder"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_tab_groups_onboarding"
      android:title="@string/preferences_tab_groups_onboarding"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_tab_groups_strip"
      android:title="@string/preferences_tab_groups_strip"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_show_tab_groups_in_menu"
      android:title="@string/preferences_tab_groups_in_menu"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_tab_reload_cover_enabled"
      android:title="@string/preferences_debug_settings_tab_reload_cover_enabled"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_tab_reload_cover_scroll_aware_enabled"
      android:dependency="@string/pref_key_tab_reload_cover_enabled"
      android:title="@string/preferences_debug_settings_tab_reload_cover_scroll_aware_enabled"
      app:iconSpaceReserved="false" />
  </PreferenceCategory>

  <PreferenceCategory
    android:selectable="false"
    android:title="@string/secret_settings_category_network_title"
    app:iconSpaceReserved="false">
    <SwitchPreferenceCompat
      android:key="@string/pref_key_doh_settings_enabled"
      android:title="@string/preferences_debug_settings_enable_doh_settings"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_enable_lna_feature_enabled"
      android:title="@string/preferences_debug_settings_enable_lna_feature"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_enable_lna_blocking_enabled"
      android:title="@string/preferences_debug_settings_enable_lna_blocking"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_enable_lna_tracker_blocking_enabled"
      android:title="@string/preferences_debug_settings_enable_lna_tracker_blocking"
      app:iconSpaceReserved="false" />
  </PreferenceCategory>

  <PreferenceCategory
    android:selectable="false"
    android:title="@string/secret_settings_category_performance_title"
    app:iconSpaceReserved="false">
    <SwitchPreferenceCompat
      android:key="@string/pref_key_enable_isolated_process"
      android:title="@string/preferences_debug_settings_isolated_process"
      app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
      android:key="@string/pref_key_enable_app_zygote_process"
      android:title="@string/preferences_debug_settings_app_zygote"
      app:iconSpaceReserved="false" />
  </PreferenceCategory>


</PreferenceScreen>
