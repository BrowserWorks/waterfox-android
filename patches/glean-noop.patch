+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+use std::{env, fs};
+
+use anyhow::{bail, Context};
+use camino::Utf8PathBuf;
+
+#[derive(Copy, Clone, Eq, PartialEq, Hash)]
+enum TargetLanguage {
+    Kotlin,
+    Swift,
+    Python,
+}
+
+fn parse_language(lang: &str) -> anyhow::Result<TargetLanguage> {
+    match lang {
+        "kotlin" => Ok(TargetLanguage::Kotlin),
+        "python" => Ok(TargetLanguage::Python),
+        "swift" => Ok(TargetLanguage::Swift),
+        _ => bail!("Unknown language"),
+    }
+}
+
+fn read_package_name(config_file: Option<&camino::Utf8Path>) -> String {
+    let default_name = "mozilla.telemetry.glean.internal".to_string();
+    let Some(config_file) = config_file else {
+        return default_name;
+    };
+    let Ok(contents) = fs::read_to_string(config_file.as_std_path()) else {
+        return default_name;
+    };
+    for line in contents.lines() {
+        let line = line.trim();
+        if !line.starts_with("package_name") {
+            continue;
+        }
+        let Some((_, value)) = line.split_once('=') else {
+            continue;
+        };
+        let value = value.trim().trim_matches('"');
+        if !value.is_empty() {
+            return value.to_string();
+        }
+    }
+    default_name
+}
+
+fn write_noop_kotlin_bindings(
+    out_dir: &camino::Utf8Path,
+    package_name: &str,
+) -> anyhow::Result<()> {
+    fs::create_dir_all(out_dir.as_std_path())?;
+    let contents = format!(
+        "package {}\n\n{}",
+        package_name,
+        r#"interface OnGleanEvents {
+    fun initializeFinished()
+    fun triggerUpload()
+    fun startMetricsPingScheduler(): Boolean
+    fun cancelUploads()
+    fun shutdown()
+}
+
+interface GleanEventListener {
+    fun onEventRecorded(id: String)
+}
+
+enum class CallbackError { UnexpectedError }
+
+enum class LevelFilter { OFF, ERROR, WARN, INFO, DEBUG, TRACE }
+enum class Lifetime { PING, APPLICATION, USER }
+enum class TimeUnit { NANOSECOND, MICROSECOND, MILLISECOND, SECOND, MINUTE, HOUR, DAY }
+enum class MemoryUnit { BYTE, KILOBYTE, MEGABYTE, GIGABYTE }
+enum class HistogramType { LINEAR, EXPONENTIAL }
+enum class ErrorType { INVALID_VALUE, INVALID_LABEL, INVALID_STATE, INVALID_OVERFLOW }
+enum class UploadTaskAction { NEXT, END }
+
+class DynamicLabelType
+
+data class InternalConfiguration(
+    val dataPath: String,
+    val applicationId: String,
+    val languageBindingName: String,
+    val uploadEnabled: Boolean,
+    val maxEvents: UInt?,
+    val delayPingLifetimeIo: Boolean,
+    val appBuild: String,
+    val useCoreMps: Boolean,
+    val trimDataToRegisteredPings: Boolean,
+    val logLevel: LevelFilter?,
+    val rateLimit: PingRateLimit?,
+    val enableEventTimestamps: Boolean,
+    val experimentationId: String?,
+    val enableInternalPings: Boolean,
+    val pingSchedule: Map<String, List<String>>,
+    val pingLifetimeThreshold: ULong,
+    val pingLifetimeMaxTime: ULong,
+)
+
+data class PingRateLimit(
+    val secondsPerInterval: Long,
+    val pingsPerInterval: Int,
+)
+
+data class ClientInfoMetrics(
+    val appBuild: String,
+    val appDisplayVersion: String,
+    val appBuildDate: Datetime,
+    val architecture: String,
+    val osVersion: String,
+    val channel: String? = null,
+    val locale: String? = null,
+    val deviceManufacturer: String? = null,
+    val deviceModel: String? = null,
+    val androidSdkVersion: String? = null,
+    val windowsBuildNumber: Long? = null,
+)
+
+data class AttributionMetrics(
+    val source: String? = null,
+    val medium: String? = null,
+    val campaign: String? = null,
+    val term: String? = null,
+    val content: String? = null,
+)
+
+data class DistributionMetrics(
+    val name: String? = null,
+)
+
+data class Datetime(
+    val year: Int,
+    val month: UInt,
+    val day: UInt,
+    val hour: UInt,
+    val minute: UInt,
+    val second: UInt,
+    val nanosecond: UInt,
+    val offsetSeconds: Int,
+)
+
+data class RecordedExperiment(
+    val branch: String,
+    val extra: Map<String, String>? = null,
+)
+
+data class RecordedEvent(
+    val timestamp: Long,
+    val category: String,
+    val name: String,
+    val extra: Map<String, String>? = null,
+)
+
+data class PingRequest(
+    val documentId: String,
+    val path: String,
+    val body: ByteArray,
+    val headers: Map<String, String>,
+    val bodyHasInfoSections: Boolean,
+    val pingName: String,
+    val uploaderCapabilities: List<String>,
+)
+
+sealed class PingUploadTask {
+    data class Upload(val request: PingRequest) : PingUploadTask()
+    data class Wait(val time: Long) : PingUploadTask()
+    data class Done(val unused: Int = 0) : PingUploadTask()
+}
+
+sealed class UploadResult {
+    data class RecoverableFailure(val unused: Int = 0) : UploadResult()
+    data class UnrecoverableFailure(val unused: Int = 0) : UploadResult()
+    data class Incapable(val unused: Int = 0) : UploadResult()
+    data class HttpStatus(val code: Int) : UploadResult()
+    data class Done(val unused: Int = 0) : UploadResult()
+}
+
+data class TimerId(val id: Long = 0)
+
+data class Rate(val numerator: Int = 0, val denominator: Int = 0)
+
+data class DistributionData(
+    val values: Map<Long, Long> = emptyMap(),
+    val sum: Long = 0,
+    val count: Long = 0,
+)
+
+data class CommonMetricData(
+    val category: String,
+    val name: String,
+    val sendInPings: List<String>,
+    val lifetime: Lifetime,
+    val disabled: Boolean,
+    val dynamicLabel: DynamicLabelType? = null,
+)
+
+sealed class LabeledMetricData {
+    data class Common(val cmd: CommonMetricData) : LabeledMetricData()
+    data class CustomDistribution(
+        val cmd: CommonMetricData,
+        val rangeMin: Long,
+        val rangeMax: Long,
+        val bucketCount: Long,
+        val histogramType: HistogramType,
+    ) : LabeledMetricData()
+
+    data class MemoryDistribution(
+        val cmd: CommonMetricData,
+        val unit: MemoryUnit,
+    ) : LabeledMetricData()
+
+    data class TimingDistribution(
+        val cmd: CommonMetricData,
+        val unit: TimeUnit,
+    ) : LabeledMetricData()
+}
+
+class CounterMetric(private val meta: CommonMetricData) {
+    fun add(amount: Int = 1) {}
+    fun testGetValue(pingName: String? = null): Int? = 0
+    fun testGetNumRecordedErrors(error: ErrorType): Int = 0
+}
+
+class TimespanMetric(private val meta: CommonMetricData, private val timeUnit: TimeUnit) {
+    fun start() {}
+    fun stop() {}
+    fun cancel() {}
+    fun setRawNanos(elapsed: Long) {}
+    fun testGetValue(pingName: String? = null): Long? = 0
+    fun testGetNumRecordedErrors(error: ErrorType): Int = 0
+}
+
+class BooleanMetric(private val meta: CommonMetricData) {
+    fun set(value: Boolean) {}
+    fun testGetValue(pingName: String? = null): Boolean? = false
+    fun testGetNumRecordedErrors(error: ErrorType): Int = 0
+}
+
+class StringMetric(private val meta: CommonMetricData) {
+    fun set(value: String) {}
+    fun testGetValue(pingName: String? = null): String? = ""
+    fun testGetNumRecordedErrors(error: ErrorType): Int = 0
+}
+
+class LabeledCounter(private val meta: LabeledMetricData, private val labels: List<String>?) {
