<SearchPlugin xmlns="http://www.mozilla.org/2006/browser/search/">
<ShortName>Waterfox Private Search</ShortName>
<Description>Waterfox Private Search</Description>
<InputEncoding>UTF-8</InputEncoding>
<Image width="36" height="36">data:image/svg+xml;base64,</Image>
<Url type="application/x-suggestions+json" method="GET" template="https://search.waterfox.com/autocomplete">
  <Param name="q" value="{searchTerms}"/>
</Url>
<Url type="text/html" method="GET" template="https://search.waterfox.com/search">
  <Param name="q" value="{searchTerms}"/>
</Url>
<SearchForm>https://search.waterfox.com/</SearchForm>
</SearchPlugin>
