#!/bin/sh

if [ -n "$GITHUB_ACTIONS" ]; then
    export MOZ_ANDROID_FAT_AAR_ARCHITECTURES="armeabi-v7a,arm64-v8a,x86_64"
fi

clang23="$HOME/.mozbuild/clang-23"
wasi_sysroot="$HOME/.mozbuild/sysroot-wasm32-wasi"

ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-android-emulator
ac_add_options --enable-android-subproject=fenix
ac_add_options --enable-application=mobile/android
if [ ! -x "$clang23/bin/clang" ] || [ ! -x "$clang23/bin/clang++" ] ||
   [ ! -f "$wasi_sysroot/.clang-23" ] ||
   [ ! -f "$wasi_sysroot/lib/wasm32-wasip1/crt1.o" ] ||
   [ ! -d "$wasi_sysroot/include/wasm32-wasip1" ]; then
    echo "mozconfig: run scripts/fetch-clang-23.sh to prepare Clang 23 and its WASI sysroot." >&2
    exit 1
fi
export PATH="$clang23/bin:$PATH"
export CC="$clang23/bin/clang"
export CXX="$clang23/bin/clang++"
export HOST_CC="$CC"
export HOST_CXX="$CXX"
export WASM_CC="$CC"
export WASM_CXX="$CXX"
export LLVM_PROFDATA="$clang23/bin/llvm-profdata"
ac_add_options --enable-bootstrap=-clang,-sysroot-wasm32-wasi
ac_add_options --with-wasi-sysroot="$wasi_sysroot"
ac_add_options --enable-geckoview-lite
ac_add_options --enable-appservices-in-tree
ac_add_options --enable-isolated-process
ac_add_options --enable-isolated-zygote-process
ac_add_options --without-onnx-runtime
ac_add_options --enable-lto
ac_add_options --enable-optimize="-O3 -w"
ac_add_options --enable-release
ac_add_options --enable-rust-simd
if test -x "$(command -v sccache)"; then
    ac_add_options --with-ccache=sccache
elif test -f "$HOME/.mozbuild/sccache/sccache"; then
    ac_add_options --with-ccache="$HOME"/.mozbuild/sccache/sccache
fi
ac_add_options --enable-update-channel=release
ac_add_options RUSTC_OPT_LEVEL=3

mk_add_options AUTOCLOBBER=1
mk_add_options MOZ_OBJDIR=./objdir

export MOZ_REQUIRE_SIGNING=
export MOZ_TELEMETRY_REPORTING=
export RUST_ANDROID_GRADLE_PYTHON_COMMAND=python3
export SCCACHE_DIR=~/Library/Caches/Mozilla.sccache/android
