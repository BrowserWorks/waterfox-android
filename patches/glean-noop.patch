+package mozilla.telemetry.glean.internal
+
+private val callbacks = object : OnGleanEvents {
+    override fun initializeFinished() = error("Initialization callback must not run")
+    override fun triggerUpload() = error("Upload callback must not run")
+    override fun startMetricsPingScheduler(): Boolean = error("Scheduler must not run")
+    override fun cancelUploads() = error("Upload callback must not run")
+    override fun shutdown() = error("Shutdown callback must not run")
+}
+
+private fun configuration(mode: SessionMode) = InternalConfiguration(
+    dataPath = "noop-must-not-create-this-directory",
+    applicationId = "noop.fixture",
+    languageBindingName = "Kotlin",
+    uploadEnabled = true,
+    maxEvents = 1u,
+    delayPingLifetimeIo = false,
+    appBuild = "fixture",
+    useCoreMps = true,
+    trimDataToRegisteredPings = false,
+    logLevel = LevelFilter.TRACE,
+    rateLimit = PingRateLimit(1uL, 1u),
+    enableEventTimestamps = true,
+    experimentationId = "must-not-be-recorded",
+    enableInternalPings = true,
+    pingSchedule = mapOf("events" to listOf("metrics")),
+    pingLifetimeThreshold = 1uL,
+    pingLifetimeMaxTime = 1uL,
+    maxPendingPingsCount = ULong.MAX_VALUE,
+    maxPendingPingsDirectorySize = ULong.MAX_VALUE,
+    sessionMode = mode,
+    sessionSampleRate = 1.0,
+    sessionInactivityTimeoutMs = ULong.MAX_VALUE,
+)
+
+private fun exerciseSessionApi() {
+    gleanSessionStart()
+    gleanSessionEnd()
+    gleanSessionEnd(null)
+    gleanSessionEnd(reason = "must-not-be-recorded")
+    gleanHandleClientActive()
+    gleanHandleClientInactive()
+    for (inSession in listOf(false, true)) {
+        val meta = CommonMetricData("fixture", "event", listOf("events"), Lifetime.PING, false, inSession = inSession)
+        val event = EventMetric(meta, listOf("secret"))
+        repeat(3) {
+            gleanSessionStart()
+            event.record(mapOf("secret" to "must-not-be-recorded"))
+            gleanSessionEnd("boundary-must-not-be-recorded")
+        }
+        check(event.testGetValue() == emptyList<RecordedEvent>())
+        check(event.testGetValue("events") == emptyList<RecordedEvent>())
+        check(event.testGetNumRecordedErrors(ErrorType.INVALID_STATE) == 0)
+    }
+    gleanUpdateAttribution(AttributionMetrics(source = "must-not-be-recorded"))
+    check(gleanTestGetAttribution() == AttributionMetrics())
+    gleanClearAttribution()
+    gleanClearAttribution()
+    check(gleanTestGetAttribution() == AttributionMetrics())
+    gleanUpdateDistribution(DistributionMetrics(name = "must-not-be-recorded"))
+    check(gleanTestGetDistribution() == DistributionMetrics())
+    gleanClearDistribution()
+    gleanClearDistribution()
+    check(gleanTestGetDistribution() == DistributionMetrics())
+    gleanSetUploadEnabled(true)
+    gleanSubmitPingByName("events", "must-not-upload")
+    check(!gleanSubmitPingByNameSync("events"))
+    check(gleanGetRegisteredPingNames().isEmpty())
+    check(gleanGetUploadTask() is PingUploadTask.Done)
+    for (result in listOf(
+        UploadResult.RecoverableFailure(), UploadResult.UnrecoverableFailure(),
+        UploadResult.Incapable(), UploadResult.HttpStatus(200), UploadResult.Done(),
+    )) {
+        check(gleanProcessPingUploadResponse("ignored", result) == UploadTaskAction.END)
+        check(gleanGetUploadTask() is PingUploadTask.Done)
+    }
+}
+
+fun main() {
+    val uuid = UuidMetric(CommonMetricData("fixture", "uuid", listOf("events"), Lifetime.PING, false))
+    check(uuid.testGetValue()?.let { java.util.UUID.fromString(it) } == null)
+    uuid.set("12345678-1234-1234-1234-123456789abc")
+    uuid.generateAndSet()
+    check(uuid.testGetValue("events")?.let { java.util.UUID.fromString(it) } == null)
+    val metadata = SessionMetadata("provided-by-caller", ULong.MAX_VALUE, ULong.MAX_VALUE, 0.5)
+    check(metadata.sessionStartTime == null)
+    val event = RecordedEvent(ULong.MAX_VALUE, "fixture", "event")
+    check(event.session == null)
+    check(event.copy(session = metadata).session == metadata)
+    check(metadata.copy(sessionStartTime = "2026-01-01T00:00:00Z").sessionStartTime != null)
+    val timer: ULong = TimerId().id
+    check(timer == 0uL)
+    check(PingUploadTask.Wait(ULong.MAX_VALUE).time == ULong.MAX_VALUE)
+    gleanEnableLoggingToFd(ULong.MAX_VALUE)
+    gleanRegisterEventListener("fixture", object : GleanEventListener {
+        override fun onEventRecorded(id: String) = error("Events must not be recorded")
+    })
+    exerciseSessionApi()
+    for (mode in SessionMode.entries) {
+        val cfg = configuration(mode)
+        check(!java.io.File(cfg.dataPath).exists())
+        gleanInitialize(cfg, ClientInfoMetrics("fixture", "fixture", Datetime(2026, 1u, 1u, 0u, 0u, 0u, 0u, 0), "test", "test"), callbacks)
+        gleanInitializeForSubprocess(cfg.copy(maxPendingPingsCount = null, maxPendingPingsDirectorySize = null))
+        exerciseSessionApi()
+        check(gleanTestGetExperimentationId() == null)
+        gleanPersistPingLifetimeData()
+        gleanShutdown()
+        exerciseSessionApi()
+        check(!java.io.File(cfg.dataPath).exists())
+    }
+    gleanUnregisterEventListener("fixture")
+}
