+        }
+        let callback = !body.contains("constructor(");
+        let marker = if callback {
+            format!("interface {name} {{")
+        } else {
+            format!("class {name}(")
+        };
+        let implementation = kotlin
+            .split_once(&marker)
+            .unwrap_or_else(|| panic!("Missing {name}"))
+            .1;
+        let implementation = compact(&format!(
+            "{marker}{}",
+            implementation.split("\n}\n").next().unwrap()
+        ))
+        .replace(",)", ")");
+        for method in body.split(';').map(str::trim).filter(|s| !s.is_empty()) {
+            let method = method
+                .rsplit_once(']')
+                .map_or(method, |(_, method)| method.trim());
+            let (declaration, args) = method.split_once('(').unwrap();
+            let args = split_types(args.strip_suffix(')').unwrap())
+                .into_iter()
+                .map(kotlin_field)
+                .collect::<Vec<_>>()
+                .join(", ");
+            let signature = if declaration == "constructor" {
+                format!("class {name}({args})")
+            } else {
+                let (return_type, method_name) = declaration.rsplit_once(' ').unwrap();
+                let signature = format!("fun {}({args})", camel(method_name));
+                if return_type == "void" {
+                    if callback {
+                        signature
+                    } else {
+                        format!("{signature} {{}}")
+                    }
+                } else {
+                    let signature = format!("{signature}: {}", kotlin_type(return_type));
+                    if callback {
+                        signature
+                    } else {
+                        format!("{signature} =")
+                    }
+                }
+            };
+            assert!(
+                implementation.contains(&compact(&signature)),
+                "{name}: missing {signature}"
+            );
+        }
+    }
+}
