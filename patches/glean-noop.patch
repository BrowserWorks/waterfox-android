+        Self(path)
+    }
+}
+
+impl Drop for TestDir {
+    fn drop(&mut self) {
+        fs::remove_dir_all(&self.0).unwrap();
+    }
+}
+
+fn generated() -> String {
+    let dir = TestDir::new();
+    write_noop_kotlin_bindings(&dir.0, "mozilla.telemetry.glean.internal").unwrap();
+    fs::read_to_string(dir.0.join("GleanNoop.kt")).unwrap()
+}
+
+fn without_comments(source: &str) -> String {
+    source
+        .lines()
+        .map(|line| line.split_once("//").map_or(line, |(code, _)| code))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn compact(source: &str) -> String {
+    source.chars().filter(|c| !c.is_whitespace()).collect()
+}
+
+fn camel(name: &str) -> String {
+    let mut parts = name.split('_');
+    let mut result = parts.next().unwrap().to_owned();
+    for part in parts {
+        let mut chars = part.chars();
+        result.extend(chars.next().unwrap().to_uppercase());
+        result.extend(chars);
+    }
+    result
+}
+
+fn split_types(source: &str) -> Vec<&str> {
+    let mut depth = 0;
+    source
+        .split(|c| match c {
+            '<' => {
+                depth += 1;
+                false
+            }
+            '>' => {
+                depth -= 1;
+                false
+            }
+            ',' => depth == 0,
+            _ => false,
+        })
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .collect()
+}
+
+fn kotlin_type(udl: &str) -> String {
+    if let Some(inner) = udl.strip_suffix('?') {
+        return format!("{}?", kotlin_type(inner));
+    }
+    if let Some(inner) = udl
+        .strip_prefix("sequence<")
+        .and_then(|s| s.strip_suffix('>'))
+    {
+        return if inner == "u8" {
+            "ByteArray".into()
+        } else {
+            format!("List<{}>", kotlin_type(inner))
+        };
+    }
+    if let Some(inner) = udl
+        .strip_prefix("record<")
+        .and_then(|s| s.strip_suffix('>'))
+    {
+        let types = split_types(inner);
+        return format!("Map<{}, {}>", kotlin_type(types[0]), kotlin_type(types[1]));
+    }
+    match udl {
+        "string" | "DOMString" | "CowString" | "JsonValue" => "String",
+        "boolean" => "Boolean",
+        "u64" => "ULong",
+        "u32" => "UInt",
+        "i64" => "Long",
+        "i32" => "Int",
+        "i8" => "Byte",
+        "f64" => "Double",
+        other => other,
+    }
+    .to_owned()
+}
+
+fn kotlin_field(field: &str) -> String {
+    let field = field
+        .trim()
+        .strip_prefix("optional ")
+        .unwrap_or(field.trim());
+    let (declaration, default) = field
+        .split_once('=')
+        .map_or((field, None), |(decl, value)| {
+            (decl.trim(), Some(value.trim()))
+        });
+    let (ty, name) = declaration.rsplit_once(' ').unwrap();
+    let mut result = format!("{}: {}", camel(name), kotlin_type(ty));
+    if let Some(default) = default {
+        result.push_str(&format!(" = {default}"));
+    }
+    result
+}
